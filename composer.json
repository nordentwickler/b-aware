{
  "name": "nordentwickler/b-aware",
  "require": {
    "craftcms/ckeditor": "^5.9.0",
    "craftcms/cms": "^5.11.5.1",
    "craftcms/contact-form": "3.1.0",
    "ether/seo": "5.0.0",
    "nystudio107/craft-vite": "^5.0.2",
    "putyourlightson/craft-elements-panel": "3.0.1",
    "sebastianlenz/linkfield": "3.0.0-beta",
    "verbb/formie": "^4.0.4",
    "vlucas/phpdotenv": "^5.4.0",
    "webhubworks/craft-panoptikum-cell": "^4.7"
  },
  "require-dev": {
    "cweagans/composer-patches": "^1.7",
    "spatie/craft-ray": "^2.0",
    "yiisoft/yii2-shell": "^2.0.3"
  },
  "autoload": {
    "psr-4": {
      "modules\\": "modules/",
      "sitemodule\\": "modules/sitemodule/src"
    }
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "cweagans/composer-patches": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2"
    }
  },
  "extra": {
    "patches": {
      "sebastianlenz/craft-utils": {
        "Fix array_unique stringify crash on fields without __toString (Formie Name field)": "patches/craft-utils-foreignfield-array_unique-sort-regular.patch"
      }
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example.dev', '.env');\""
    ],
    "post-autoload-dump": [
      "vendor/bin/panoptikum-git-commands.sh"
    ]
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://composer.craftcms.com",
      "canonical": false
    },
    {
      "type": "composer",
      "url": "https://packages.webhub.de"
    }
  ]
}
